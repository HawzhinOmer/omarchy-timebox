{
  "schemaVersion": 1,
  "id": "hawzhin.timebox",
  "name": "Timebox Planner",
  "version": "1.3.0",
  "author": "hawzhin",
  "description": "Daily timebox planner: top priorities, brain dump, half-hour schedule, and reminders when a block starts",
  "kinds": [
    "overlay",
    "bar-widget",
    "service"
  ],
  "keepLoaded": false,
  "entryPoints": {
    "overlay": "Timebox.qml",
    "barWidget": "TimeboxBar.qml",
    "service": "Reminders.qml"
  },
  "barWidget": {
    "displayName": "Timebox",
    "description": "Shows the current timebox and opens the planner",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "maxLength": 28,
      "showNext": true
    },
    "schema": [
      {
        "key": "maxLength",
        "type": "number",
        "label": "Max label length"
      },
      {
        "key": "showNext",
        "type": "boolean",
        "label": "Show next block when idle"
      }
    ]
  }
}
